digraph G {
  graph [rankdir=LR, fontsize=10, fontname="Pretendard"];
  node  [shape=rect, style=rounded, color="#94a3b8", fontname="Pretendard"];

  DAS  [label="DAS\n(수집·적재: train/test)"];
  PRE  [label="전처리\n(IQR·표준화·FS)"];
  MOD  [label="모델링\n(Stage-1·전문가·게이팅)"];
  DSS  [label="DSS\n(후처리·캘리브레이션)"];
  WSS  [label="WSS\n(Streamlit 시각화)"];

  DAS -> PRE -> MOD -> DSS -> WSS;

  // JPS는 파이프라인/스케줄러로 학습·제출 트리거만 표시
  JPS  [label="JPS\n(스케줄·실행·아티팩트)", shape=folder];
  JPS -> MOD;
  JPS -> DSS;
}

